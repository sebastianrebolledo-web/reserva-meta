# ──────────────────────────────────────────────────────────────────────────────
# Frontend — Variables de Entorno
# ──────────────────────────────────────────────────────────────────────────────
#
# DESARROLLO LOCAL:
#   Deja NEXT_PUBLIC_API_URL vacío. Las llamadas a /api/v1/* serán re-escritas
#   por next.config.ts hacia http://127.0.0.1:8000 (el backend FastAPI local).
#
# PRODUCCIÓN (Cloud Run):
#   BACKEND_INTERNAL_URL se inyecta en RUNTIME al desplegar con deploy_cloud_run.sh.
#   El servidor Next.js usa esta variable para hacer proxy al backend FastAPI.
#   NO requiere re-build de la imagen.
#
# ──────────────────────────────────────────────────────────────────────────────

# URL del backend — dejar vacío en desarrollo local (next.config.ts lo resuelve)
NEXT_PUBLIC_API_URL=""

# Dominio corporativo para validación de correo
NEXT_PUBLIC_CORPORATE_DOMAIN="grupotecfluid.com"

# (Solo para Cloud Run / runtime) URL interna del backend FastAPI.
# Se pasa con --set-env-vars en deploy_cloud_run.sh. No es necesario en .env.local.
# BACKEND_INTERNAL_URL="https://tecfluid-vr-backend-xxxxxxxxxx-uc.a.run.app"
