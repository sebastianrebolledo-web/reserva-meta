# ==========================================
# Configuración General del Backend
# ==========================================
PROJECT_NAME="Sistema de Reserva Meta Quest"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Dominio corporativo obligatorio para solicitantes
CORPORATE_DOMAIN="grupotecfluid.com"

# Correo de notificación a soporte TI
IT_SUPPORT_EMAIL="soporteti@grupotecfluid.com"

# ==========================================
# Integración con Google APIs (Calendar & Gmail)
# ==========================================
# Modo de autenticación: "service_account" o "oauth2"
GOOGLE_AUTH_MODE="service_account"

# Opción A: Service Account
GOOGLE_SERVICE_ACCOUNT_FILE="service-account.json"
# Correo del usuario a impersonar si se usa Delegación de Dominio en Google Workspace (opcional):
GOOGLE_DELEGATED_USER="soporteti@grupotecfluid.com"

# Opción B: OAuth 2.0 (si GOOGLE_AUTH_MODE="oauth2")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# ID del Calendario en Google Calendar (por defecto "primary" o ID tipo "xxx@group.calendar.google.com")
GOOGLE_CALENDAR_ID="primary"

# Remitente de los correos vía Gmail API
GMAIL_SENDER_EMAIL="soporteti@grupotecfluid.com"
